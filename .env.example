# =====================================================
# Backend — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commitar .env.
# =====================================================

# Porta do servidor Express
PORT=3000

# Origens permitidas no CORS (separadas por vírgula).
# Em produção, troque por https://seu-dominio.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Resend — https://resend.com (3.000 emails/mês grátis)
# Crie conta, verifique domínio (ou use onboarding@resend.dev em teste) e pegue a API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Remetente verificado no Resend. Em teste pode usar "onboarding@resend.dev".
MAIL_FROM=Larissa Portfolio <onboarding@resend.dev>
# Caixa que recebe os contatos do formulário.
MAIL_TO=larissaalmeidalima9@gmail.com

# GitHub — usuário público que aparecerá na seção de repositórios
GITHUB_USERNAME=larissalima
# (Opcional) Personal Access Token sem escopo — só aumenta o rate-limit
# da API do GitHub de 60/h para 5000/h. Útil em produção.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Ambiente
NODE_ENV=development
